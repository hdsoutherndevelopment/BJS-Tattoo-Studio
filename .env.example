SUPABASE_SERVICE_ROLE_KEY=

BUSINESS_EMAIL=
NEXT_PUBLIC_SITE_URL=https://www.bjstattoostudio.co.uk
NEXT_PUBLIC_BUSINESS_NAME=BJ's Tattoo Studio
